{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "PORT=22814 BASE_PATH=/ pnpm --filter @workspace/party-game run build",
  "outputDirectory": "artifacts/party-game/dist/public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' https://live.oathstone.stackstoneconsulting.co.uk wss://live.oathstone.stackstoneconsulting.co.uk; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), screen-wake-lock=(self), publickey-credentials-get=(self), publickey-credentials-create=(self)"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/play/:path*", "destination": "/app-shell.html" },
    { "source": "/practice/:path*", "destination": "/app-shell.html" },
    { "source": "/create/:path*", "destination": "/app-shell.html" },
    { "source": "/join/:path*", "destination": "/app-shell.html" },
    { "source": "/join-request/:path*", "destination": "/app-shell.html" },
    { "source": "/coordinate/:path*", "destination": "/app-shell.html" },
    { "source": "/game/:path*", "destination": "/app-shell.html" },
    { "source": "/tv/:path*", "destination": "/app-shell.html" },
    { "source": "/account/:path*", "destination": "/app-shell.html" },
    { "source": "/admin/:path*", "destination": "/app-shell.html" },
    { "source": "/recap/:path*", "destination": "/app-shell.html" }
  ]
}
