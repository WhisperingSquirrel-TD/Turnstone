{
  "name": "@workspace/party-game",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "vite build --config vite.config.ts",
    "build:static-public": "PORT=3000 BASE_PATH=/ COMING_SOON_MODE=true PRE_LAUNCH_NOINDEX=true vite build --config vite.config.ts",
    "serve": "tsx src/serve.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@workspace/security": "workspace:*",
    "@workspace/shared": "workspace:*",
    "express": "5.2.1",
    "qrcode.react": "4.2.0",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.102.8",
    "@types/express": "5.0.6",
    "@types/node": "25.9.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@workspace/api-client-react": "workspace:*",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "7.18.4",
    "tailwindcss": "4.3.3",
    "vite": "7.3.7"
  }
}
