modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["alsa-lib", "at-spi2-atk", "atk", "cairo", "cups", "dbus", "enchant", "flite", "gcc", "gdk-pixbuf", "glib", "graphene", "gst_all_1.gst-libav", "gst_all_1.gst-plugins-bad", "gst_all_1.gst-plugins-base", "gst_all_1.gstreamer", "gtk4", "harfbuzz", "harfbuzzFull", "hyphen", "icu74", "lcms2", "libGL", "libavif", "libdrm", "libepoxy", "libevent", "libglvnd", "libjpeg_turbo", "libmanette", "libopus", "libsecret", "libwebp", "libxkbcommon", "libxml2", "libxslt", "mesa", "nspr", "nss", "pango", "sqlite", "vulkan-loader", "wayland", "x264", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb"]
