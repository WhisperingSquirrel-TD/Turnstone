modules = ["nodejs-24", "postgresql-16", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

# Used only if the owner later selects Replit Static Deployment; this does not change the current Autoscale target.
[[deployment.rewrites]]
from = "/play"
to = "/app-shell.html"
[[deployment.rewrites]]
from = "/play/*"
to = "/app-shell.html"
[[deployment.rewrites]]
from = "/practice"
to = "/app-shell.html"
[[deployment.rewrites]]
from = "/practice/*"
to = "/app-shell.html"
[[deployment.rewrites]]
from = "/create"
to = "/app-shell.html"
[[deployment.rewrites]]
from = "/create/*"
to = "/app-shell.html"
[[deployment.rewrites]]
from = "/join"
to = "/app-shell.html"
[[deployment.rewrites]]
from = "/join/*"
to = "/app-shell.html"
[[deployment.rewrites]]
from = "/join-request"
to = "/app-shell.html"
[[deployment.rewrites]]
from = "/join-request/*"
to = "/app-shell.html"
[[deployment.rewrites]]
from = "/coordinate"
to = "/app-shell.html"
[[deployment.rewrites]]
from = "/coordinate/*"
to = "/app-shell.html"
[[deployment.rewrites]]
from = "/game"
to = "/app-shell.html"
[[deployment.rewrites]]
from = "/game/*"
to = "/app-shell.html"
[[deployment.rewrites]]
from = "/tv"
to = "/app-shell.html"
[[deployment.rewrites]]
from = "/tv/*"
to = "/app-shell.html"
[[deployment.rewrites]]
from = "/account"
to = "/app-shell.html"
[[deployment.rewrites]]
from = "/account/*"
to = "/app-shell.html"
[[deployment.rewrites]]
from = "/admin"
to = "/app-shell.html"
[[deployment.rewrites]]
from = "/admin/*"
to = "/app-shell.html"
[[deployment.rewrites]]
from = "/recap"
to = "/app-shell.html"
[[deployment.rewrites]]
from = "/recap/*"
to = "/app-shell.html"

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["alsa-lib", "at-spi2-atk", "atk", "cairo", "cups", "dbus", "enchant", "flite", "gcc", "gdk-pixbuf", "glib", "graphene", "gst_all_1.gst-libav", "gst_all_1.gst-plugins-bad", "gst_all_1.gst-plugins-base", "gst_all_1.gstreamer", "gtk4", "harfbuzz", "harfbuzzFull", "hyphen", "icu74", "lcms2", "libGL", "libavif", "libdrm", "libepoxy", "libevent", "libglvnd", "libjpeg_turbo", "libmanette", "libopus", "libsecret", "libwebp", "libxkbcommon", "libxml2", "libxslt", "mesa", "nspr", "nss", "pango", "sqlite", "vulkan-loader", "wayland", "x264", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb", "libgbm", "webkitgtk_6_0", "libsoup_3", "libbacktrace", "libjxl"]
