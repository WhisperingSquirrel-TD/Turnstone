modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["glib", "gtk4", "pango", "harfbuzz", "gdk-pixbuf", "cairo", "vulkan-loader", "graphene", "icu74", "libxml2", "sqlite", "libxslt", "lcms2", "libevent", "libopus", "gst_all_1.gstreamer", "gst_all_1.gst-plugins-base", "gst_all_1.gst-plugins-bad", "flite", "libavif", "libwebp", "xorg.libX11", "wayland", "libmanette", "enchant", "mesa", "libdrm", "libsecret", "hyphen", "atk", "at-spi2-atk", "libxkbcommon", "libGL", "x264", "nspr", "nss", "gcc", "harfbuzzFull", "libepoxy", "libjpeg_turbo", "libglvnd", "gst_all_1.gst-libav", "alsa-lib", "cups", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb", "dbus"]
